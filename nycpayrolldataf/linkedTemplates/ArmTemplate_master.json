{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "nycpayrolldataf"
		},
		"ld_dls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ld_dls'"
		},
		"ls_sqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqldb'"
		},
		"ld_dls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsnycpayrollacc.dfs.core.windows.net/"
		},
		"ls_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dbnycpayrollsqlserver.database.windows.net"
		},
		"ls_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_nycpayroll"
		},
		"ls_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin123"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "nycpayrolldataf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ld_dls_accountKey": {
						"value": "[parameters('ld_dls_accountKey')]"
					},
					"ls_sqldb_password": {
						"value": "[parameters('ls_sqldb_password')]"
					},
					"ld_dls_properties_typeProperties_url": {
						"value": "[parameters('ld_dls_properties_typeProperties_url')]"
					},
					"ls_sqldb_properties_typeProperties_server": {
						"value": "[parameters('ls_sqldb_properties_typeProperties_server')]"
					},
					"ls_sqldb_properties_typeProperties_database": {
						"value": "[parameters('ls_sqldb_properties_typeProperties_database')]"
					},
					"ls_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "nycpayrolldataf_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'nycpayrolldataf_ArmTemplate_0')]"
			]
		}
	]
}